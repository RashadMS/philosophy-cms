# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB Connection
# Get your connection string from MongoDB Atlas cloud console
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# JWT Secret (change this to a secure random string in production)
# Generate a strong random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Admin Setup Key (for initial admin creation - change in production)
ADMIN_SETUP_KEY=initial-admin-setup-key

# Email Configuration for Email Verification
# Required for user registration verification emails
# SERVICE OPTIONS: gmail, outlook, yahoo, or custom SMTP server
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@rashad.app

# Gmail Setup Instructions:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password as EMAIL_PASSWORD
# 
# For other email services (Outlook, Yahoo, etc.), refer to their SMTP documentation

